# RESCURE — Environment Variables
# Copy this to .env.local and fill in your values

# ─── Database (Supabase) ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# ─── Auth0 ───────────────────────────────────────────────────────────────────
# Create an Auth0 Application (Regular Web Application)
# https://manage.auth0.com/
AUTH0_SECRET="[generate: openssl rand -hex 32]"
AUTH0_BASE_URL="http://localhost:3000"
AUTH0_ISSUER_BASE_URL="https://[YOUR-DOMAIN].auth0.com"
AUTH0_CLIENT_ID="[YOUR-CLIENT-ID]"
AUTH0_CLIENT_SECRET="[YOUR-CLIENT-SECRET]"

# Enable Google Social Connection in Auth0 Dashboard:
# 1. Go to Authentication > Social
# 2. Enable Google
# 3. Add your Google OAuth credentials from https://console.cloud.google.com

# ─── Google AI Studio (Gemini Vision) ────────────────────────────────────────
# Free tier: 1500 requests/day — https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY="[YOUR-GEMINI-API-KEY]"

# ─── Cloudinary ──────────────────────────────────────────────────────────────
# Free tier: 25GB — https://cloudinary.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="[YOUR-CLOUD-NAME]"
CLOUDINARY_API_KEY="[YOUR-API-KEY]"
CLOUDINARY_API_SECRET="[YOUR-API-SECRET]"

# ─── Stripe ──────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs (create in Stripe dashboard)
STRIPE_PRICE_PRO_MONTHLY="price_..."       # ₹1,499/month
STRIPE_PRICE_ENTERPRISE_MONTHLY="price_..." # ₹9,999/month
STRIPE_PRICE_SPONSOR_299="price_..."
STRIPE_PRICE_SPONSOR_599="price_..."
STRIPE_PRICE_SPONSOR_1499="price_..."

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
# Generated — replace with your own: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BApLi86sNkYgjbXNNy3YTtI6z0a-BpAaB9CG2sag-NVHkE1rrAWUQGGgBLBlZOqrnnvL8vT_3oJXvmXFnqTZgw8"
VAPID_PRIVATE_KEY="[YOUR-VAPID-PRIVATE-KEY]"
VAPID_SUBJECT="mailto:admin@RESCURE.in"

# ─── Inngest ─────────────────────────────────────────────────────────────────
# Free tier: 50K runs/month — https://inngest.com
INNGEST_EVENT_KEY="[YOUR-INNGEST-EVENT-KEY]"
INNGEST_SIGNING_KEY="[YOUR-INNGEST-SIGNING-KEY]"

# ─── PostHog (Analytics) ─────────────────────────────────────────────────────
# Free tier: 1M events/month — https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ─── OpenWeatherMap (optional) ──────────────────────────────────────────────
# Free tier: 1,000 calls/day — https://openweathermap.org/api/one-call-3
# Optional: only needed for weather alert text on hotspot analysis
# Leave blank to skip OWM enrichment
OPENWEATHER_API_KEY="dc98ed3a8356b72e2689d6908c83d7e6"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="RESCURE"
